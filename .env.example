# Database — Supabase (ou qualquer PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres.[ref]:[senha]@aws-1-us-west-2.pooler.supabase.com:6543/postgres
DATABASE_SYNC_URL=postgresql://postgres.[ref]:[senha]@aws-1-us-west-2.pooler.supabase.com:5432/postgres

# Security
SECRET_KEY=supersecretkey-change-in-production-32chars-minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Backend
SCRIPTS_DIR=./scripts
MAX_CONCURRENT_EXECUTIONS=5
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
